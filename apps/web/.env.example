# Leave unset to render the four fixture cards from fantasy/stub_cards.jsonl.
# When the #106 API is up, set this and ship — no other client change.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# QA: raise the not-current-year banner while still on stubs.
# NEXT_PUBLIC_STUB_CURRENT_SEASON_MISSING=true
# Runtime-only alias (no rebuild): STUB_CURRENT_SEASON_MISSING=true

# Server-only waitlist hook (never NEXT_PUBLIC — no FO / SDIO secrets here).
# FANTASY_WAITLIST_WEBHOOK=https://hooks.example/waitlist
# FANTASY_WAITLIST_PATH=data/waitlist/signups.jsonl
